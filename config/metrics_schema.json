{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelEvaluationResult",
  "type": "object",
  "required": [
    "model_name",
    "best_params",
    "cv_macro_f1_mean",
    "cv_macro_f1_std",
    "test_overall_accuracy",
    "test_kappa",
    "test_macro_f1",
    "test_weighted_f1",
    "test_confusion_matrix",
    "class_metrics",
    "training_time_seconds",
    "classes"
  ],
  "properties": {
    "model_name": { "type": "string" },
    "best_params": { "type": "object" },
    "cv_macro_f1_mean": { "type": "number" },
    "cv_macro_f1_std": { "type": "number" },
    "test_overall_accuracy": { "type": "number" },
    "test_kappa": { "type": "number" },
    "test_macro_f1": { "type": "number" },
    "test_weighted_f1": { "type": "number" },
    "test_confusion_matrix": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "integer" }
      }
    },
    "class_metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["precision", "recall", "f1_score", "support"],
        "properties": {
          "precision": { "type": "number" },
          "recall": { "type": "number" },
          "f1_score": { "type": "number" },
          "support": { "type": "integer" }
        }
      }
    },
    "training_time_seconds": { "type": "number" },
    "classes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
